{
  "name": "adventure-map",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs",
    "validate:schema": "node scripts/validate-record-schema.mjs",
    "validate:catalog-layer": "node scripts/validate-catalog-record-layer.mjs",
    "validate:duplicates": "node scripts/validate-duplicates.mjs",
    "validate:slugs": "node scripts/validate-record-slugs.mjs",
    "validate:routing": "node scripts/validate-routing.mjs",
    "validate:route-references": "node scripts/validate-route-references.mjs",
    "validate:dependencies": "node scripts/validate-static-dependencies.mjs",
    "validate:majors": "node scripts/validate-world-majors.mjs",
    "validate:stories": "node scripts/validate-story-context.mjs",
    "validate:static": "node scripts/validate-static-publishing.mjs",
    "build:vendor": "node scripts/vendor-leaflet.mjs",
    "build:shared": "node scripts/build-shared.mjs",
    "build:catalog-layer": "node scripts/build-catalog-record-layer.mjs",
    "build:public-records": "npm run build:catalog-layer && node scripts/build-public-records.mjs",
    "build:static-site": "node scripts/build-static-site.mjs",
    "build:public-index": "node scripts/build-public-index.mjs",
    "build:publish": "npm run build:vendor && npm run build:shared && npm run build:public-records && npm run build:static-site && npm run build:public-index",
    "scan:strava": "python3 scripts/scan_strava_export.py",
    "advance:strava": "python3 scripts/advance_strava_state.py",
    "test:record-schema": "node scripts/test-record-schema.mjs",
    "test:update-pipeline": "python3 scripts/test_update_pipeline.py"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "leaflet": "1.9.4"
  }
}
